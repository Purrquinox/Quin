generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogAuthor {
  id              Int               @id @default(autoincrement())
  documentId      String            @unique
  name            String
  username        String            @unique
  uid             String            @unique
  bio             String
  avatar          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  publishedAt     DateTime?         @default(now())
  BlogPost        BlogPost[]
  BlogSocial      BlogSocial[]
  PurrdexAuditLog PurrdexAuditLog[]
  PurrdexEntry    PurrdexEntry[]
}

model BlogPost {
  id          Int        @id @default(autoincrement())
  documentId  String     @unique
  slug        String     @unique
  title       String
  description String
  content     String
  tags        String[]
  badges      String[]
  locale      String
  platform    String
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  publishedAt DateTime?  @default(now())
  authorId    Int
  BlogAuthor  BlogAuthor @relation(fields: [authorId], references: [id])
}

model BlogSocial {
  id         Int        @id @default(autoincrement())
  url        String
  platform   String
  authorId   Int
  BlogAuthor BlogAuthor @relation(fields: [authorId], references: [id])
}

model CareerApplication {
  id             Int            @id @default(autoincrement())
  documentId     String         @unique
  positionId     Int
  firstName      String
  lastName       String
  email          String
  phone          String
  resumeUrl      String
  coverLetterUrl String?
  portfolioUrl   String?
  linkedinUrl    String?
  status         String         @default("Pending")
  reviewedBy     String?
  reviewedByUid  String?
  reviewedAt     DateTime?
  reviewNotes    String?
  appliedAt      DateTime       @default(now())
  updatedAt      DateTime
  CareerPosition CareerPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model CareerPosition {
  id                Int                 @id @default(autoincrement())
  documentId        String              @unique
  title             String
  department        String
  location          String
  employmentType    String
  description       String
  requirements      String[]
  responsibilities  String[]
  benefits          String[]
  experienceLevel   String
  status            String              @default("Open")
  postedDate        DateTime            @default(now())
  closingDate       DateTime?
  createdBy         String
  createdByUid      String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  CareerApplication CareerApplication[]
}

model DisciplinaryAction {
  id              Int       @id @default(autoincrement())
  documentId      String    @unique
  employeeName    String
  employeeId      String
  employeeEmail   String
  issueDate       DateTime
  incidentDate    DateTime
  actionType      String
  severity        String
  title           String
  description     String
  violation       String
  witnesses       String[]
  evidence        String[]
  actionTaken     String
  improvementPlan String?
  followUpDate    DateTime?
  issuedBy        String
  issuedByUid     String
  status          String    @default("Active")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
}

model Feature {
  id        Int     @id @default(autoincrement())
  name      String
  projectId Int
  Project   Project @relation(fields: [projectId], references: [id])
}

model LeaveOfAbsence {
  id            Int       @id @default(autoincrement())
  documentId    String    @unique
  employeeName  String
  employeeId    String
  employeeEmail String
  employeeUid   String
  leaveType     String
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  description   String?
  attachments   String[]
  status        String    @default("Pending")
  reviewedBy    String?
  reviewedByUid String?
  reviewedAt    DateTime?
  reviewNotes   String?
  isEmergency   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
}

model Project {
  id          Int          @id @default(autoincrement())
  title       String
  logo        String
  banner      String?
  link        String
  launched    String
  category    String
  description String
  users       String
  uptime      Float
  Feature     Feature[]
  Technology  Technology[]
}

model PurrdexAuditLog {
  id             Int          @id @default(autoincrement())
  entryId        Int
  action         String
  performedById  Int
  changes        String?
  previousValues String?
  newValues      String?
  createdAt      DateTime     @default(now())
  PurrdexEntry   PurrdexEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  BlogAuthor     BlogAuthor   @relation(fields: [performedById], references: [id])
}

model PurrdexCategory {
  id           Int            @id @default(autoincrement())
  documentId   String         @unique
  name         String         @unique
  slug         String         @unique
  description  String
  icon         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  PurrdexEntry PurrdexEntry[]
}

model PurrdexEntry {
  id              Int               @id @default(autoincrement())
  documentId      String            @unique
  title           String
  slug            String            @unique
  category        String
  summary         String
  content         String
  tags            String[]
  images          String[]
  relatedEntries  String[]
  authorId        Int
  status          String            @default("Draft")
  views           Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  publishedAt     DateTime?
  PurrdexAuditLog PurrdexAuditLog[]
  BlogAuthor      BlogAuthor        @relation(fields: [authorId], references: [id])
  PurrdexCategory PurrdexCategory   @relation(fields: [category], references: [name])
}

model Technology {
  id        Int     @id @default(autoincrement())
  name      String
  projectId Int
  Project   Project @relation(fields: [projectId], references: [id])
}

model QuinUserProfile {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  username        String
  displayName     String?
  facts           String[] // Learned facts about the user
  preferences     Json?    // User preferences and interests
  relationships   Json?    // Relationships with other users
  personality     String?  // User's personality traits
  lastInteraction DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([lastInteraction])
}

model QuinConversation {
  id               Int               @id @default(autoincrement())
  userId           String
  username         String
  discordServerId  String?
  discordChannelId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  QuinConversationMessage QuinConversationMessage[]
  QuinConversationSummary QuinConversationSummary?

  @@index([userId])
  @@index([discordServerId, discordChannelId])
}

model QuinConversationMessage {
  id                 Int                @id @default(autoincrement())
  conversationId     Int
  role               String             // 'user', 'assistant', 'system', 'tool'
  content            String
  toolCallId         String?
  toolName           String?
  metadata           Json?              // Store additional metadata like userInfo, context, etc.
  createdAt          DateTime           @default(now())
  QuinConversation   QuinConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model QuinConversationSummary {
  id             Int              @id @default(autoincrement())
  conversationId Int              @unique
  summary        String           // AI-generated summary of key points
  keyTopics      String[]         // Important topics discussed
  learnedFacts   String[]         // New facts learned about user
  sentiment      String?          // Overall sentiment of conversation
  lastSummaryAt  DateTime         @updatedAt
  createdAt      DateTime         @default(now())
  
  QuinConversation QuinConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@index([lastSummaryAt])
}
